# ---------------------------------------------------------------------------
# Client (bundled into the browser build — nothing secret belongs here)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase Auth over Resend SMTP
# Local: read from this file by supabase/config.toml.
# Hosted: set under Project Settings -> Authentication -> SMTP.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5173
SMTP_USER=resend
SMTP_PASSWORD=re_<your-resend-api-key>
SMTP_SENDER=no-reply@<your-verified-domain>

# ---------------------------------------------------------------------------
# Edge function secrets
# Hosted: supabase secrets set --env-file supabase/.env
# Never expose these to the browser.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_FROM=AgriVault <no-reply@<your-verified-domain>>
RESEND_REPLY_TO=support@<your-verified-domain>
DEVICE_INGEST_KEY=<long random string the sensor rigs send as x-device-key>

# Firebase bridge — the rig writes here, sync-readings pulls it into Postgres.
# FIREBASE_DB_SECRET can be left blank if the RTDB rules already allow reads.
FIREBASE_DB_URL=https://agrivault-1a19d-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DB_SECRET=<RTDB secret, or a token with read access>
SYNC_KEY=<long random string the scheduler sends as x-sync-key>
ALLOWED_ORIGINS=http://localhost:5173
